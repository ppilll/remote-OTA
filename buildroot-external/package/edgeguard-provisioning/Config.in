config BR2_PACKAGE_EDGEGUARD_PROVISIONING
	bool "edgeguard-provisioning"
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_JSON_GLIB
	help
	  EdgeGuard BLE provisioning daemon using GLib/GIO/GDBus,
	  JSON-GLib, BlueZ, ConnMan and Linux input APIs.

	  BlueZ, ConnMan and system D-Bus are runtime requirements. Their exact
	  vendor-SDK BR2 symbols must be confirmed before adding select clauses;
	  this external tree does not contain those symbol definitions.
